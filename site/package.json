{
  "name": "kmsg-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "npm run sync:content && react-router build && node scripts/build-static.mjs",
    "build:router": "react-router build",
    "dev": "react-router dev",
    "sync:content": "node scripts/sync-markdown-content.mjs",
    "typecheck": "react-router typegen && tsc",
    "test:vitest": "vitest run",
    "test:node": "node --test test/*.test.mjs",
    "test:unit": "npm run test:vitest && npm run test:node",
    "test": "npm run build && npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.36",
    "lucide-react": "^1.28.0",
    "marked": "18.0.7",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.3.0",
    "sanitize-html": "2.17.6",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
